---
import SearchModal from './SearchModal.vue';
---

<header class="sticky top-0 z-40 bg-[#070a13]/95 backdrop-blur-md border-b border-slate-800/80 w-full px-4 sm:px-8 lg:px-12 py-3.5 transition-colors">
  <div class="w-full flex items-center justify-between gap-4">
    <!-- Logo e Identidad Académica -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-400 via-sky-500 to-purple-600 flex items-center justify-center font-mono font-black text-slate-950 text-xl shadow-[0_0_18px_rgba(6,182,212,0.45)] group-hover:scale-105 group-hover:shadow-[0_0_24px_rgba(168,85,247,0.55)] transition duration-300">
        C
      </div>
      <div>
        <div class="flex items-center gap-2.5">
          <span class="font-extrabold text-base sm:text-lg text-white tracking-wide font-sans group-hover:text-cyan-400 transition">
            COMPILADORES
          </span>
          <span class="text-xs uppercase font-mono font-bold px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 shadow-[0_0_8px_rgba(34,211,238,0.2)]">
            v0.3 • LAB & GUÍA
          </span>
        </div>
        <p class="text-xs text-slate-400 font-mono hidden sm:block">Teoría rigurosa, C3D & Arquitectura RISC-V</p>
      </div>
    </a>

    <!-- Enlaces Principales de Navegación Desktop -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-mono font-medium">
      <a href="/modulo/1-fundamentos" class="text-slate-300 hover:text-cyan-400 transition flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        Módulos (1-8)
      </a>
      <a href="/laboratorio" class="text-slate-300 hover:text-purple-400 flex items-center gap-2 transition">
        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
        Laboratorio
      </a>
      <a href="/ejercicios" class="text-slate-300 hover:text-emerald-400 flex items-center gap-2 transition">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Ejercicios & Quiz
      </a>
      <a href="/formulario" class="text-slate-300 hover:text-sky-400 flex items-center gap-2 transition">
        <span class="w-2 h-2 rounded-full bg-sky-400"></span>
        Formulario KaTeX
      </a>
      <a href="/bibliografia" class="text-slate-400 hover:text-slate-200 transition">Bibliografía</a>
    </nav>

    <!-- Herramientas: Buscador y Botón Menú Móvil -->
    <div class="flex items-center gap-3">
      <SearchModal client:load />

      <!-- Botón de apertura de menú en móvil -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-slate-300 hover:text-cyan-400 hover:border-cyan-500/50 transition focus:outline-none focus:ring-1 focus:ring-cyan-400"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable para móvil -->
  <div id="mobile-nav-panel" class="hidden md:hidden border-t border-slate-800 mt-3 pt-3 pb-2 space-y-2 text-sm font-mono animate-in fade-in duration-200">
    <a href="/modulo/1-fundamentos" class="flex items-center justify-between py-2.5 px-3.5 rounded-xl bg-slate-900/60 hover:bg-slate-800 text-slate-200 border border-slate-800/80">
      <span class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        Módulos Académicos (1 al 8)
      </span>
      <span class="text-xs text-cyan-400 font-bold">8 temas ➔</span>
    </a>
    <a href="/laboratorio" class="flex items-center justify-between py-2.5 px-3.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/50 text-purple-300 border border-purple-500/40 font-bold">
      <span class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
        ⚡ Laboratorio Interactivo
      </span>
      <span class="text-xs text-purple-400">Simuladores & POO</span>
    </a>
    <a href="/ejercicios" class="flex items-center justify-between py-2.5 px-3.5 rounded-xl bg-emerald-950/40 hover:bg-emerald-900/50 text-emerald-300 border border-emerald-500/40 font-bold">
      <span class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        🎯 Banco de Ejercicios
      </span>
      <span class="text-xs text-emerald-400">25 preguntas ➔</span>
    </a>
    <a href="/formulario" class="flex items-center justify-between py-2.5 px-3.5 rounded-xl bg-sky-950/40 hover:bg-sky-900/50 text-sky-300 border border-sky-500/40">
      <span class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-sky-400"></span>
        📐 Formulario KaTeX
      </span>
      <span class="text-xs text-sky-400">Fórmulas</span>
    </a>
    <a href="/bibliografia" class="block py-2.5 px-3.5 rounded-xl hover:bg-slate-800 text-slate-400">
      📚 Bibliografía & Fuentes del Ing. Ramírez Tobar
    </a>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    if (toggleBtn && panel) {
      toggleBtn.addEventListener('click', () => {
        panel.classList.toggle('hidden');
      });
    }
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
