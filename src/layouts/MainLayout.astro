---
import '../styles/global.css';
import ReadingProgress from '../components/ReadingProgress.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
}

const {
  title,
  description = 'Guía interactiva y completa de Compiladores: Análisis léxico, sintáctico, semántico, C3D y ensamblador RISC-V RV32I.',
  currentSlug = ''
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth dark text-base">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Compiladores: Guía & Laboratorio</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Overpass:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#070a13] text-[#e2e8f0] font-sans min-h-screen flex flex-col selection:bg-cyan-500 selection:text-slate-950 relative overflow-x-hidden text-base leading-relaxed">
    <!-- Efectos ambientales de fondo en cyan y morado -->
    <div class="fixed top-0 left-1/4 w-[500px] h-[500px] bg-cyan-500/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed top-1/3 right-10 w-[500px] h-[500px] bg-purple-600/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed bottom-10 left-10 w-[500px] h-[500px] bg-sky-500/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <ReadingProgress />
    <Header />

    <!-- Disposición Fluid Full-Width Responsiva -->
    <div class="w-full flex-1 flex flex-col lg:flex-row relative">
      <Sidebar currentSlug={currentSlug} />

      <main class="flex-1 p-4 sm:p-8 lg:p-12 min-w-0 w-full max-w-7xl mx-auto">
        <slot />
      </main>
    </div>

    <Footer />
  </body>
</html>
