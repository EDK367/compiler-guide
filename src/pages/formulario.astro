---
import MainLayout from '../layouts/MainLayout.astro';
import FormulasViewer from '../components/FormulasViewer.vue';
---

<MainLayout
  title="Formulario de Compiladores: Reglas, Ecuaciones y Procedimientos"
  description="Compendio exhaustivo de fórmulas matemáticas, algoritmos de análisis sintáctico, reglas FIRST/FOLLOW, aplanamiento de arreglos y codificación de instrucciones RISC-V."
>
  <div class="space-y-8">
    <div class="border-b border-slate-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold bg-cyan-950/60 text-cyan-300 border border-cyan-500/30 mb-3 shadow-[0_0_12px_rgba(6,182,212,0.25)]">
        <span>📐</span>
        <span>FORMULARIO MATEMÁTICO & ALGORÍTMICO</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Formulario de Compiladores
      </h1>
      <p class="text-xs sm:text-base text-slate-300 mt-2 leading-relaxed font-sans">
        Este módulo reúne todas las definiciones matemáticas formales, procedimientos algorítmicos, fórmulas de aplanado de arreglos multidimensionales, cálculo de conjuntos predictivos y formatos de instrucción RISC-V. Cada regla incluye su definición formal en <span class="text-cyan-300 font-mono font-bold">KaTeX</span>, desglose de símbolos, procedimiento paso a paso, ejemplo resuelto, errores frecuentes y ejercicio propuesto con solución explicada.
      </p>
    </div>

    <!-- Visor Interactivo de Fórmulas -->
    <FormulasViewer client:load />
  </div>
</MainLayout>
