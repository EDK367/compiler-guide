---
import MainLayout from '../layouts/MainLayout.astro';
import { REFERENCES } from '../data/referencesData';
---

<MainLayout
  title="Bibliografía y Fuentes Académicas"
  description="Referencias bibliográficas oficiales y fuentes obligatorias que respaldan cada sección de la guía de compiladores."
>
  <div class="space-y-8">
    <div class="border-b border-slate-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold bg-purple-950/60 text-purple-300 border border-purple-500/30 mb-3 shadow-[0_0_12px_rgba(168,85,247,0.2)]">
        <span>📚</span>
        <span>FUENTES OFICIALES & RESPALDO ACADÉMICO</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Bibliografía y Referencias
      </h1>
      <p class="text-xs sm:text-base text-slate-300 mt-2 leading-relaxed font-sans">
        Toda la estructura conceptual, la terminología técnica, las convenciones de memoria y los ejemplos desarrollados en esta guía se basan rigurosamente en el material de cátedra oficial del <strong class="text-cyan-300">Ing. Mario Ramírez Tobar</strong> y en la literatura fundamental de compiladores y arquitectura de procesadores.
      </p>
    </div>

    <div class="space-y-6">
      {REFERENCES.map((ref) => (
        <div class="bg-[#0d1527] rounded-2xl border border-slate-800 hover:border-cyan-500/30 p-4 sm:p-6 shadow-xl space-y-4 transition duration-200">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-3">
            <div>
              <span class={`text-[10px] font-mono uppercase px-2.5 py-0.5 rounded-full font-bold border ${
                ref.type === 'pdf' ? 'bg-purple-950/80 text-purple-300 border-purple-500/30' :
                ref.type === 'web' ? 'bg-cyan-950/80 text-cyan-300 border-cyan-500/30' : 'bg-slate-900 text-sky-300 border-sky-500/30'
              }`}>
                {ref.type === 'pdf' ? 'Documento PDF Oficial' : ref.type === 'web' ? 'Sitio Web de Referencia' : 'Literatura Académica'}
              </span>
              <h3 class="text-lg sm:text-xl font-bold text-white mt-2 font-sans">{ref.title}</h3>
              <p class="text-xs font-mono text-cyan-400 mt-0.5">{ref.author} {ref.year && `(${ref.year})`}</p>
            </div>
            {ref.url && (
              <a
                href={ref.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-cyan-950/60 border border-slate-700 hover:border-cyan-500/40 text-xs font-mono text-cyan-300 transition flex items-center gap-1.5 shadow-sm"
              >
                <span>Acceder al recurso</span>
                <span>↗</span>
              </a>
            )}
          </div>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">
            {ref.details}
          </p>

          <div class="space-y-2 bg-[#080d1a] p-3.5 sm:p-4 rounded-xl border border-slate-800/80">
            <span class="text-[11px] font-mono text-cyan-400 font-bold block">Temas y cobertura exacta:</span>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-300 font-sans">
              {ref.topicsCovered.map((top) => (
                <li class="flex items-start gap-2">
                  <span class="text-purple-400 font-bold">•</span>
                  <span>{top}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</MainLayout>
